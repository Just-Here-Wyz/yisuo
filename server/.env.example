# ─────────────────────────────────────────────
#  复制本文件为 .env，填入 API Key 即可启用真翻译。
#  换服务商只改 TRANSLATE_PROVIDER，其余不用动。
# ─────────────────────────────────────────────

# ── 免费档（推荐，2026-10-08 核实）─────────────
#
#  zhipu        GLM-4-Flash 永久免费、不限 Token（并发 30），国内直连 ★最推荐
#               注册：https://open.bigmodel.cn  → 控制台 → API Keys
#
#  siliconflow  Qwen2.5-7B-Instruct 等 9B 以下模型永久免费，国内延迟低
#               注册：https://cloud.siliconflow.cn
#
#  groq         有免费额度（以官网为准），需网络代理
#               注册：https://console.groq.com
#
# ── 付费档 ────────────────────────────────────
#  deepseek / openai / moonshot / dashscope / custom

TRANSLATE_PROVIDER=zhipu

# 你的 API Key（只留在本地，不会下发给浏览器）
TRANSLATE_API_KEY=

# 可选：覆盖默认模型
# TRANSLATE_MODEL=glm-4-flash

# provider=custom 时必填，需为 OpenAI 兼容的 /chat/completions 接口
# TRANSLATE_BASE_URL=

# 端口
PORT=8787
